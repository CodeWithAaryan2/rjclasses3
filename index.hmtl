<meta property="og:description" content="Class 8–12 tuition for SSC, ICSE and CBSE, and NEET, MHT-CET and JEE preparation, next to Cubic Mall, Chembur.">
<meta property="og:locale" content="en_IN">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Hind:wght@400;500;600;700&family=Kalam:wght@400;700&display=swap" rel="stylesheet">

<script type="application/ld+json">
{
  "@context": "https://schema.org",
